# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# ---- required ----
DB_PASSWORD=change-me-to-a-long-random-string
# Generate with: openssl rand -base64 48
JWT_SECRET=

# ---- optional: create the first administrator on startup (password: 8+ characters) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- local Docker only ----
WEB_PORT=8088

# ---- production only (docker-compose.prod.yml) ----
DOMAIN=
GHCR_OWNER=your-github-username-in-lowercase
IMAGE_TAG=latest
